# =============================================================================
# Growth Technos Backend — Environment Configuration
# =============================================================================

# Application
NODE_ENV=development
PORT=5001
API_VERSION=v1
APP_NAME=Growth Technos
APP_URL=http://localhost:5001
CLIENT_URL=http://localhost:3000
# Extra origins allowed for CORS (comma-separated).
# In production, include both apex domain, www, and any staging/preview domains:
# CORS_ORIGINS=https://www.growthtechnos.com,https://growthtechnos.com,https://growth-technos-smart.vercel.app,http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3002,http://127.0.0.1:3002

# Database (include the DB name in the path — without it MongoDB defaults to "test")
MONGODB_URI=mongodb://localhost:27017/growth-technos
# Atlas example:
# MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/growth-technos?retryWrites=true&w=majority

# JWT
JWT_ACCESS_SECRET=your-super-secret-access-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_REMEMBER_EXPIRES_IN=30d

# Password reset
PASSWORD_RESET_TOKEN_EXPIRES_IN=1h

# Cookies
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Redis (optional — set REDIS_ENABLED=true to activate)
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Email
# Email (Hostinger business email). See docs/LEADS_SETUP.md in the website repo.
# Hostinger: SMTP_HOST=smtp.hostinger.com, port 465 with SMTP_SECURE=true (or 587 + false)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@growthtechnos.com
SMTP_PASS=
# Lead confirmation emails are sent from this address
EMAIL_FROM=info@growthtechnos.com
EMAIL_FROM_NAME=Growth Technos

# ---- Lead system (Free Process Audit form) ----------------------------------
# Who gets the "New lead: company – solution – budget" email
LEAD_NOTIFY_EMAIL=
# Confirmation email to the lead (set to false to turn it off)
LEAD_CONFIRMATION_EMAIL_ENABLED=true
# WhatsApp number printed in the confirmation email
LEAD_CONFIRMATION_WHATSAPP=+91 97568 96250
# Max form submissions per IP per 15 minutes
LEAD_SUBMIT_RATE_LIMIT=5

# Google Sheets (service account). Leave empty to skip this step.
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_TAB=Leads
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private key in double quotes, keeping the \n sequences:
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
GOOGLE_PRIVATE_KEY=

# Telegram (optional). Leave empty to skip.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
AUTH_RATE_LIMIT_MAX_REQUESTS=1000

# Logging
LOG_LEVEL=debug
LOG_FORMAT=combined

# Swagger
SWAGGER_ENABLED=true

# Bcrypt
BCRYPT_SALT_ROUNDS=12

# Seed (optional — used by npm run seed)
SEED_ADMIN_EMAIL=admin@growthtechnos.com
SEED_ADMIN_PASSWORD=Admin@123456

# Frontend cache revalidation (optional — enables on-demand ISR purge after CMS publish)
FRONTEND_REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATION_SECRET=your-revalidation-secret-change-in-production

# Public website origin used by seed/sync scripts for canonical URLs
PUBLIC_SITE_URL=https://www.growthtechnos.com
# Frontend repo path for seed/sync scripts (default: ../growth-technos-smart)
# FRONTEND_ROOT=../growth-technos-smart
